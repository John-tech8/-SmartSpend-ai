# SmartSpend AI - Environment Configuration
# Copy this file to .env and fill in your actual credentials

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (SAFE for client/browser exposure)
# Do NOT place your SUPABASE_SERVICE_ROLE_KEY here.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Groq API Key for AI Financial Advisor (llama-3.3-70b-versatile)
GROQ_API_KEY=gsk_...

# Backend Port (defaults to 5000 if omitted)
PORT=5000
